@using EntityLayer.Concrete
@model List<Address>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Adres Listesi</h4>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Açıklama1</th>
                            <th>Açıklama2</th>
                            <th>Açıklama3</th>
                            <th>Açıklama4</th>
                            <th>Sil</th>
                            <th>Düzenle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AddressID</td>
                                <td>@item.Description1</td>
                                <td>@item.Description2</td>
                                <td>@item.Description3</td>
                                <td>@item.Description4</td>
                                <td><a href="/Address/DeleteAddress/@item.AddressID" class="btn-outline-info">Sil</a></td>
                                <td><a href="/Address/EditAddress/@item.AddressID" class="btn-outline-warning">Düzenle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Address/AddAddress class="btn btn-secondary">Yeni Adres Girişi</a>
            </div>
        </div>
    </div>
</div>


