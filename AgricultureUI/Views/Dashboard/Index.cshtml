@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_DashboardHeaderPartial")

<body>

    @await Component.InvokeAsync("_DashboardNavbarPartial")

    @await Component.InvokeAsync("_DashboardOverviewPartial")

    @await Component.InvokeAsync("_DashboardChartPartial")

    @await Component.InvokeAsync("_DashboardTablePartial")

    <script src="~/AdminUI/template/vendors/base/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page-->
    <script src="~/AdminUI/template/vendors/chart.js/Chart.min.js"></script>
    <script src="~/AdminUI/template/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/AdminUI/template/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    <!-- End plugin js for this page-->
    <!-- inject:js -->
    <script src="~/AdminUI/template/js/off-canvas.js"></script>
    <script src="~/AdminUI/template/js/hoverable-collapse.js"></script>
    <script src="~/AdminUI/template/js/template.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page-->
    <script src="~/AdminUI/template/js/dashboard.js"></script>
    <script src="~/AdminUI/template/js/data-table.js"></script>
    <script src="~/AdminUI/template/js/jquery.dataTables.js"></script>
    <script src="~/AdminUI/template/js/dataTables.bootstrap4.js"></script>
    <!-- End custom js for this page-->

    <script src="~/AdminUI/template/js/jquery.cookie.js" type="text/javascript"></script>
</body>
</html>