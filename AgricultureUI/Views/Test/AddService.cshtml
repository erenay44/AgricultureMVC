@model EntityLayer.Concrete.Service
@{
    ViewData["Title"] = "AddService";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>AddService</h1>

<form method="post">
    <div class="form-check">
    @Html.Label("Başlık")
    <input type="text" asp-for="Title" />
    </div>
    <div class="form-check">
        @Html.Label("Görsel Yolu")
        <input type="text" asp-for="Image" />
    </div> 
    <div class="form-check">
        @Html.Label("Açıklama")
        <input type="text" asp-for="Description" />
    </div>
    <button class="btn btn-outline-warning">Kaydet</button>
</form>