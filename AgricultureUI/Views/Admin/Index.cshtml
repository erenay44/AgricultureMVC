@using EntityLayer.Concrete
@model List<Admin>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<h1>Admin Listesi</h1>
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Listesi</h4>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kullanıcı Adı</th>
                            <th>Sil</th>
                            <th>Düzenle</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AdminId</td>
                                <td>@item.Username</td>>
                                <td><a href="/Announcement/DeleteAnnouncement/@item.AdminId" class="btn btn-outline-info">Sil</a></td>
                                <td><a href="/Announcement/EditAnnouncement/@item.AdminId" class="btn btn-outline-warning">Düzenle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Admin/AddAdmin" class="btn btn-secondary">Yeni Admin Girişi</a>
            </div>
        </div>
    </div>
</div>

