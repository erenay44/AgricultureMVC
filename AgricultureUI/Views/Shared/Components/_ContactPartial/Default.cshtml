@model EntityLayer.Concrete.Contact

<div class="col-md-9 contact-middle">
	<h2>İletişim Formu</h2>
	<form action="#" method="post">
		<div class="form-agileinfo">
			<p>Adınız Soyadınız</p>
			<input type="text" name="your name" placeholder="Adınız Soyadınız" required="" />
			<p>Email</p>
			<input type="email" name="your email" placeholder="E-posta" required="" />
		</div>
		<div class="form-agileits-w3layouts">
			<p>Mesajınız</p>
			<textarea name="your message" placeholder="Mesajınız" required=""></textarea>
			<input type="submit" value="Gönder">
		</div>
		<div class="clearfix"></div>
	</form>
</div>
