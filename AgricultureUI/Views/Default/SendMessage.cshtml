@model EntityLayer.Concrete.Contact

<div class="col-md-9 contact-middle">
	<h2>İletişim Formu</h2>
	<form method="post">
		<div class="form-agileinfo">
			<p>Adınız Soyadınız</p>
			<input type="text" asp-for="Name" name="your name" placeholder="Adınız Soyadınız" required="" />
			<p>Email</p>
			<input type="email" asp-for="Mail" name="your email" placeholder="E-posta" required="" />
		</div>
		<div class="form-agileits-w3layouts">
			<p>Mesajınız</p>
			<textarea name="your message" asp-for="Message" placeholder="Mesajınız" required=""></textarea>
			<input type="submit" value="Gönder">
		</div>
		<div class="clearfix"></div>
	</form>
</div>
