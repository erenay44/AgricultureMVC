@using EntityLayer.Concrete
@model List<Announcement>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Listesi</h4>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Tarih</th>
                            <th>Sil</th>
                            <th>Düzenle</th>
                            <th>Aktif</th>
                            <th>Pasif</th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AnnouncementId</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@item.Date</td>
                                <td><a href="/Announcement/DeleteAnnouncement/@item.AnnouncementId" class="btn-outline-info">Sil</a></td>
                                <td><a href="/Announcement/EditAnnouncement/@item.AnnouncementId" class="btn-outline-warning">Düzenle</a></td>
                                <td><a href="/Announcement/ChangeStatusToTrue/@item.AnnouncementId" class="btn-outline-success">Aktif Yap</a></td>
                                <td><a href="/Announcement/ChangeStatusToFalse/@item.AnnouncementId" class="btn-outline-danger">Pasif Yap</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Announcement/AddAnnouncement" class="btn btn-secondary">Yeni Duyuru Girişi</a>
            </div>
        </div>
    </div>
</div>
