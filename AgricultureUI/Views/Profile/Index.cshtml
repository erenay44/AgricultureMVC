@model AgricultureUI.Models.UserEditViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Profil Güncelleme</h4>
            <form class="forms-sample" method="post">
                <div class="form-group">
                    <label for="exampleInputUsername1">Mail Adresi</label>
                    <input type="text" class="form-control" placeholder="Mail Adresi" asp-for="Mail">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail1">Telefon Numarası</label>
                    <input type="text" class="form-control" placeholder="Telefon Numarası" asp-for="Phone">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail1">Şifre</label>
                    <input type="text" class="form-control" placeholder="Şifre" asp-for="Password">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail1">Şifre</label>
                    <input type="text" class="form-control" placeholder="Şifreyi tekrar giriniz" asp-for="ConfirmPassword">
                </div>
                <button type="submit" class="btn btn-primary me-2">Kaydet</button>
            </form>
        </div>
    </div>
</div>


